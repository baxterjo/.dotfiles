# Theme 
theme = Catppuccin Mocha

# Font 
font-family = JetBrains Mono
font-size = 14
font-feature = -liga
font-feature = -clig
font-feature = zero
font-feature = ss01
adjust-underline-position = -4

# Cursor.
cursor-style = underline
cursor-style-blink = true

# Window options
macos-titlebar-style = transparent
window-padding-x = 4
window-padding-y = 4
window-colorspace = display-p3

# Shell & env.
working-directory = home
env = EDITOR=nvim

# Required for M- bindings to reach tmux and nvim.
macos-option-as-alt = left

# Push TERM and terminfo to remote hosts. Off by default, and xterm-ghostty
# is not in the system terminfo database.
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path

# Let Shift-PageUp/PageDown fall through to tmux rather than adjusting a
# Ghostty selection.
keybind = shift+page_up=unbind
keybind = shift+page_down=unbind


